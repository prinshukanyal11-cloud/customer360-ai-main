# =============================================================================
# Customer360 AI — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=Customer360 AI
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=change-me-please-use-a-long-random-value
JWT_SECRET=change-me-please-use-a-different-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---------------------------------------------------------------
POSTGRES_USER=customer360
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=customer360
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://customer360:change-me-db-password@localhost:5432/customer360
# Read-only URL used by NL-to-SQL (must be a credential with SELECT-only rights)
DATABASE_URL_RO=postgresql+psycopg://customer360_ro:change-me-ro-password@localhost:5432/customer360

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- LLM providers (provider abstraction — only set what you use) -----------
# LLM_PROVIDER: openai | gemini | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
# Timeout in seconds for LLM calls
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Security ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list, e.g. http://localhost:3000
SECURITY_HEADERS_ENABLED=true

# Rate limiting. Requests per minute per client; /auth/* uses the tighter budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Where the counters live: auto | memory | redis.
#   memory - per process. Correct for a single API process or local development.
#   redis  - shared, so the budget is a property of the deployment. Required once
#            more than one replica serves traffic, or N replicas grant N x the limit.
#   auto   - redis when reachable, memory otherwise; a redis outage degrades the
#            limiter rather than taking the API down.
RATE_LIMIT_BACKEND=auto
# Blank means REDIS_URL.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=ratelimit
# Only enable behind a proxy that overwrites X-Forwarded-For. Trusting it when the
# app is directly reachable lets any caller forge the header and escape the limit.
RATE_LIMIT_TRUST_PROXY=false
# Kept reachable when the limiter is saturated, so a traffic spike cannot make the
# orchestrator kill the container. Matched as path suffixes.
RATE_LIMIT_EXEMPT_PATHS=/health,/ready,/docs,/openapi.json

# Sign-in lockout. Failures are counted per submitted address, so the response
# cannot reveal whether an address is registered. Generous by design: a lower
# threshold lets anyone who can reach the form lock a colleague out.
LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# Failures older than this start a fresh count instead of accumulating.
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Refresh tokens are stored (hashed) so they can be revoked and rotated. Reusing a
# revoked token revokes the whole rotation family, which forces a fresh sign-in.

# File upload limits (bytes)
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.csv,.xlsx,.parquet

# --- Demo / Sample data ------------------------------------------------------
DEMO_MODE=true
ENABLE_SAMPLE_DATA=true
SAMPLE_DATA_PATH=./data/sample

# --- Frontend ----------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# --- Monitoring / Observability ----------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=